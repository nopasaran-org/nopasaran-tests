{
  "id": "MAIN",
  "initial": "INITIALIZING",
  "states": {
    "INITIALIZING": {
      "on": {
        "STARTED": [
          {
            "target": "INITIATING_CONTROL_CHANNEL",
            "actions": []
          }
        ]
      }
    },
    "INITIATING_CONTROL_CHANNEL": {
      "entry": [
        {
          "type": "get_from_file (variables role) (role)"
        },
        {
          "type": "get_from_file (variables controller_conf_filename) (controller_conf_filename)"
        },
        {
          "type": "get_from_file (variables client) (client)"
        },
        {
          "type": "get_from_file (variables server) (server)"
        },
        {
          "type": "get_from_file (variables port) (port)"
        },
        {
          "type": "call (CONTROL_CHANNEL_SET_UP role controller_conf_filename) (event ctrl)"
        },
        {
          "type": "trigger (event)"
        }
      ],
      "on": {
        "DONE": [
          {
            "target": "SENDING_QUERY",
            "cond": "equal (role client)",
            "actions": [
              {
                "type": "assign (role) (role)"
              },
              {
                "type": "assign (client) (client)"
              },
              {
                "type": "assign (port) (dport)"
              },
              {
                "type": "assign (ctrl) (ctrl)"
              }
            ]
          },
          {
            "target": "STARTING_SERVER",
            "cond": "equal (role server)",
            "actions": [
              {
                "type": "assign (role) (role)"
              },
              {
                "type": "assign (client) (client)"
              },
              {
                "type": "assign (port) (port)"
              },
              {
                "type": "assign (ctrl) (ctrl)"
              }
            ]
          }
        ]
      }
    },
    "SENDING_QUERY": {
      "entry": [
        {
          "type": "get_from_file (variables ip) (ip)"
        },
        {
          "type": "set (0.2) (time)"
        },
        {
          "type": "wait (time)"
        },
        {
          "type": "get_from_file (variables qname) (qname)"
        },
        {
          "type": "get_from_file (variables query_type) (query_type)"
        },
        {
          "type": "make_tcp_dns_query (qname query_type ip dport) (received)"
        },
        {
          "type": "create_dict (dict)"
        },
        {
          "type": "add_element_to_dict (dict received) (dict)"
        },
        {
          "type": "done"
        }
      ],
      "on": {
        "DONE": [
          {
            "target": "EXCHANGE_SYNC",
            "actions": [
              {
                "type": "assign (dict) (dict)"
              },
              {
                "type": "assign (ctrl) (ctrl)"
              }
            ]
          }
        ]
      }
    },
    "STARTING_SERVER": {
      "entry": [
        {
          "type": "create_tcp_dns_server (server)"
        },
        {
          "type": "start_tcp_dns_server (server port)"
        },
        {
          "type": "get_from_file (variables response_spec) (response_spec)"
        },
        {
          "type": "set (10) (timeout)"
        },
        {
          "type": "wait_and_respond_tcp_dns_query (server port timeout response_spec) (received)"
        },
        {
          "type": "create_dict (dict)"
        },
        {
          "type": "add_element_to_dict (dict received) (dict)"
        },
        {
          "type": "done"
        }
      ],
      "on": {
        "DONE": [
          {
            "target": "EXCHANGE_SYNC",
            "actions": [
              {
                "type": "assign (dict) (dict)"
              },
              {
                "type": "assign (ctrl) (ctrl)"
              }
            ]
          }
        ]
      }
    },
    "EXCHANGE_SYNC": {
      "entry": [
        {
          "type": "call (EXCHANGE_SYNC ctrl dict) (event sync_dict)"
        },
        {
          "type": "set (ready_stop) (signal_type)"
        },
        {
          "type": "call (SERVER_SIGNALING signal_type) (signaling-event)"
        }
      ]
    }
  }
}
